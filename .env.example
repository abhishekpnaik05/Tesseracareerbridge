# Database
POSTGRES_USER=tessera
POSTGRES_PASSWORD=tessera_dev_only
POSTGRES_DB=tesseracareerbridge
POSTGRES_PORT=55432
DATABASE_URL=postgresql://tessera:tessera_dev_only@localhost:55432/tesseracareerbridge?schema=public

# Server
NODE_ENV=development
SERVER_PORT=4000
SERVER_URL=http://localhost:4000
API_PREFIX=/api/v1

# Client
CLIENT_URL=http://localhost:5173
VITE_API_URL=http://localhost:4000/api/v1

# Authentication (replace with long random values in real environments)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Object storage (local adapter for development; S3-compatible later)
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage/local
STORAGE_PUBLIC_BASE_URL=http://localhost:4000/storage

# Development seed users only (pnpm db:seed). Never used in production.
# student@tesseracareerbridge.dev
# mentor@tesseracareerbridge.dev
# admin@tesseracareerbridge.dev
# content@tesseracareerbridge.dev
# superadmin@tesseracareerbridge.dev
SEED_DEV_PASSWORD=DevPass123

# Email Configuration
# Configure either Resend (recommended) or SMTP to enable real email delivery for OTP verification
# Leave both empty to use development log-only mailer

# Resend (Recommended - easier setup)
RESEND_API_KEY=
EMAIL_FROM=

# SMTP (Alternative - traditional SMTP server)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# SMS Configuration (for phone OTP verification)
# Configure either Twilio or MSG91 to enable real SMS delivery
# Leave both empty to use development log-only SMS provider

# Twilio (Recommended - global coverage)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# MSG91 (Alternative - popular in India)
MSG91_AUTH_KEY=
MSG91_SENDER_ID=

# WhatsApp Configuration (for phone OTP verification)
# Configure either Meta WhatsApp Business API or Twilio WhatsApp
# Leave both empty to use development log-only WhatsApp provider

# Meta WhatsApp Business API (Recommended - official WhatsApp Business API)
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=

# Twilio WhatsApp (Alternative - uses Twilio's WhatsApp integration)
TWILIO_WHATSAPP_NUMBER=

PAYMENT_PROVIDER=
PAYMENT_SECRET_KEY=
