# Database
POSTGRES_USER=tessera
POSTGRES_PASSWORD=tessera_dev_only
POSTGRES_DB=tesseracareerbridge
POSTGRES_PORT=55432
DATABASE_URL=postgresql://tessera:tessera_dev_only@localhost:55432/tesseracareerbridge?schema=public

# Server
NODE_ENV=development
SERVER_PORT=4000
SERVER_URL=http://localhost:4000
API_PREFIX=/api/v1

# Client
CLIENT_URL=http://localhost:5173
VITE_API_URL=http://localhost:4000/api/v1

# Authentication (replace with long random values in real environments)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Object storage (local adapter for development; S3-compatible later)
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage/local
STORAGE_PUBLIC_BASE_URL=http://localhost:4000/storage

# Development seed users only (pnpm db:seed). Never used in production.
