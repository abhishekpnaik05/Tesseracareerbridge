{
  "buildCommand": "pnpm --filter @tesseracareerbridge/shared build && pnpm --filter @tesseracareerbridge/client build",
  "outputDirectory": "client/dist",
  "installCommand": "pnpm install --frozen-lockfile",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
