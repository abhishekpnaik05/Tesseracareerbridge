    "typecheck": "tsc -p tsconfig.json --noEmit",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.8.2",
    "bcryptjs": "^3.0.3",
    "prisma": "^6.8.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
